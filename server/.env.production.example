# Copiá este archivo a ".env.production" en el servidor (NO lo subas al repo)
# y completá los valores reales. docker-compose.yml lo lee automáticamente.

# Generá uno nuevo con: openssl rand -hex 32
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# PORT y DB_PATH los define docker-compose.yml — no hace falta repetirlos acá.
